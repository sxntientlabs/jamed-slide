JAMED_AI_BASE_URL=https://rcljvh2.abc-tunnel.us/v1
JAMED_AI_API_KEY=
JAMED_AI_MODEL=sur/deepseek-v4.1-flash
# Optional Koasis model routes. Defaults map Cito/Elective/Executive to
# the Luna/Terra/Sol provider aliases when a model is selected in the UI.
JAMED_AI_MODEL_CITO=cx/gpt-5.6-luna
JAMED_AI_MODEL_ELECTIVE=cx/gpt-5.6-terra
JAMED_AI_MODEL_EXECUTIVE=cx/gpt-5.6-sol
JAMED_RENDERER_URL=https://server.eltexlabs.com/koasis-renderer
JAMED_RENDERER_TOKEN=

# Leave empty for the normal same-origin App Hosting deployment and local
# development. Set this only for a direct Dokploy staging build.
VITE_KOASIS_API_BASE_URL=
# Used only by the direct Dokploy staging service; App Hosting is same-origin.
KOASIS_CORS_ORIGINS=http://localhost:4173,https://koasis.my.id

# Firebase Web App config for client-side Auth + metadata Firestore.
# These values are supplied by your Firebase project settings; do not put
# service-account credentials or Secret Manager values in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=jamed-9bdbe
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only PostgreSQL for operational events and future VPS-backed records.
# Keep these out of VITE_* variables; Dokploy should inject them at runtime.
KOASIS_POSTGRES_URL=
KOASIS_POSTGRES_SSL=true
KOASIS_POSTGRES_MAX_CONNECTIONS=5
